# Copy to .env. Keep SEND/submit limits at zero until you have completed onboarding.
DATABASE_URL=postgresql+psycopg://career:career@postgres:5432/career
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=career-artifacts
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=career-system

# Keep control-plane ports private by default. Use an SSH tunnel to access the
# remote dashboard. Only set this to 0.0.0.0 behind authenticated ingress.
HOST_BIND_ADDRESS=127.0.0.1

# Any local vLLM, LiteLLM, or hosted OpenAI-compatible endpoint.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Gmail OAuth credentials are injected at deployment time, never stored in Postgres.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GITHUB_TOKEN=
GITHUB_ORG=
BROWSER_ENABLED=false
ARTIFACT_DIR=/tmp/career-artifacts

# Safety defaults. The API will refuse all external submission/sending while false.
LIVE_ACTIONS_ENABLED=false
DAILY_APPLICATION_LIMIT=0
DAILY_OUTREACH_LIMIT=0
LOG_LEVEL=INFO
